{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://yevcoxqbutlvgzvajkfc.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "conferencia-rapida",
      "version": "0.1.0",
      "title": "Conferência Rápida"
    },
    "tools": [
      {
        "name": "listar_unidades",
        "title": "Listar unidades",
        "description": "Lista as unidades cadastradas (caminhões, caixas de ferramentas e prateleiras de estoque) do usuário autenticado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "tipo": {
              "description": "Filtra por tipo de unidade.",
              "type": "string",
              "enum": [
                "caminhao",
                "caixa",
                "prateleira",
                "caixa_industria",
                "prateleira_industria"
              ]
            },
            "busca": {
              "description": "Texto livre para filtrar por nome.",
              "type": "string"
            },
            "limite": {
              "description": "Máximo de registros (padrão 50).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "listar_conferencias",
        "title": "Listar conferências",
        "description": "Lista as conferências (em andamento, pausadas, concluídas ou canceladas) com unidade, conferente, data e tempo trabalhado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filtra pelo status da conferência, ex.: concluida.",
              "type": "string"
            },
            "unidade_id": {
              "description": "Filtra por uma unidade específica (UUID).",
              "type": "string"
            },
            "limite": {
              "description": "Máximo de registros (padrão 20).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "detalhes_conferencia",
        "title": "Detalhes da conferência",
        "description": "Retorna os dados de uma conferência com o resumo de itens (total, corretos, divergências e pendentes) e a lista de divergências.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "conferencia_id": {
              "type": "string",
              "description": "UUID da conferência."
            },
            "incluir_itens": {
              "description": "Quando verdadeiro, retorna todos os itens além do resumo.",
              "type": "boolean"
            }
          },
          "required": [
            "conferencia_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "historico_conferencias",
        "title": "Histórico de conferências",
        "description": "Consulta o histórico permanente de conferências com quantidades previstas, conferidas, divergências, percentual e duração.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "modulo": {
              "description": "Filtra pelo módulo, ex.: FROTA, ESTOQUE_AGRICOLA.",
              "type": "string"
            },
            "de": {
              "description": "Data inicial no formato AAAA-MM-DD.",
              "type": "string"
            },
            "ate": {
              "description": "Data final no formato AAAA-MM-DD.",
              "type": "string"
            },
            "limite": {
              "description": "Máximo de registros (padrão 20).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "meu_perfil",
        "title": "Meu perfil de acesso",
        "description": "Retorna o perfil de acesso do usuário autenticado (nome, perfil, setor e último acesso).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
